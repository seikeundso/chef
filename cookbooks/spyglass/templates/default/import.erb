#!/usr/bin/bash
# ----------------------------------------------------------------------------

set -euo pipefail

# ----------------------------------------------------------------------------

DB=spyglass
OSMFILE=/data/planet.osm.pbf
FLATNODES=/data/flat.nodes
UPDATES=YES

export LUA_PATH="/srv/spyglass.openstreetmap.org/osm2pgsql-themepark/lua/?.lua;;"

# ----------------------------------------------------------------------------

params=("--disable-parallel-indexing")

if [ "$UPDATES" = "YES" ]; then
    params+=("--slim")
    if [ -n "$FLATNODES" ]; then
        params+=("-F" "$FLATNODES")
    fi
fi

osm2pgsql -d "$DB" -O flex -S /srv/spyglass.openstreetmap.org/data/spyglass.lua "${params[@]}" "$OSMFILE"

osm2pgsql-gen -d "$DB" -S /srv/spyglass.openstreetmap.org/data/spyglass.lua -j16

if [ "$UPDATES" = "YES" ]; then
    osm2pgsql-replication init -d "$DB" --server https://planet.osm.org/replication/minute/
fi

# ----------------------------------------------------------------------------
